PORT=3000
ENV=development
API_KEYS=demo-key-1                    # comma list; "key:tenant" binds a key to a tenant (default tenant = default)
ADMIN_API_KEY=admin-key-1

DATABASE_URL=postgresql://agent:agent@localhost:5432/agent

ANTHROPIC_API_KEY=sk-ant-...
PRIMARY_MODEL=claude-sonnet-5-5
FALLBACK_MODEL=claude-haiku-5-5
LLM_EFFORT=medium                      # output_config.effort; medium = recommended start for multi-step tool use
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1
LLM_CONCURRENCY=8
LLM_STRICT_TOOLS=true                  # strict: true on tool schemas (forced tool_choice is a 400 on Sonnet 5.5)
LLM_SERVER_FALLBACK=true               # server-side refusal fallback (beta) on the primary model
LLM_FORCE_PRIMARY_FAIL=0               # 1 = simulate primary outage (demo / fallback test)
LLM_DISABLED=0                         # 1 = no LLM at all -> static mode
CIRCUIT_FAILS_TO_OPEN=5
CIRCUIT_OPEN_MS=30000

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20                # per leg, before RRF
RETRIEVAL_MIN_VECTOR_SIM=0.30          # relevance gate; tune on eval set

TOOL_TIMEOUT_MS=2000
TOOL_MAX_RETRIES=2                     # get_account_state only
TOOL_FAIL_RATE=0.0833                  # 1/12; 0 for CI determinism, 1 to force
TOOL_FAIL_SEED=                        # optional: seed RNG for reproducible failures

AS_OF_DATE=2026-11-12
PROMPT_VERSION=v1
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_MS=25000
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_PER_MIN=60
CACHE_TTL_ACCOUNT_MS=0                 # 0 = never cache account state
ANSWER_CACHE_TTL_MS=900000             # 0 = disable the account-independent answer cache
