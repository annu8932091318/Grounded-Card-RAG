# ---------------------------------------------------------------------------------------------------------
# Copy to .env and fill in the two API keys. Every other value has a working default for local runs.
# ---------------------------------------------------------------------------------------------------------

# --- HTTP server ---
PORT=3000
ENV=development                        # development = uvicorn auto-reload when started with `python -m src.server`
API_KEYS=demo-key-1                    # comma list; "key:tenant" binds a key to a tenant (default tenant = default)
ADMIN_API_KEY=admin-key-1
RATE_LIMIT_PER_MIN=60
REQUEST_TIMEOUT_MS=30000
IDEMPOTENCY_TTL_MS=86400000            # a replayed Idempotency-Key returns the stored response for 24 h

# --- Postgres: tracking records only (requests, traces, conversations, service requests, prompts, evals) ---
# Local install, no Docker. `python -m scripts.migrate` creates the database if it does not exist.
DATABASE_URL=postgresql://agent:agent@localhost:5433/agent

# --- ChromaDB: the vector store (embedded mode = a folder on disk, no server) ---
CHROMA_PATH=chroma_data                # relative to the project root
CHROMA_COLLECTION=policy_chunks

# --- Logs: logs/<dd-mm-yyyy>output.log ---
LOG_DIR=logs
LOG_LEVEL=info                         # debug | info | warning | error
LOG_TO_CONSOLE=1

# --- LLM chain: Google Gemini (primary) -> xAI Grok (fallback) -> static mode (no LLM) ---
GEMINI_API_KEY=                        # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash   # comma list: each model is one fallback step (free-tier quotas are per model)
GEMINI_THINKING_LEVEL=                 # Gemini 3.x only: minimal | low | high (leave empty for 2.5 models)
GEMINI_TIMEOUT_MS=6000                 # a hung call fails over to the next model
# Fallback = any OpenAI-compatible endpoint. Two tested options:
#   xAI Grok : key starts xai-  GROK_BASE_URL=https://api.x.ai/v1             GROK_MODEL=grok-4-fast-non-reasoning
#   Groq     : key starts gsk_  GROK_BASE_URL=https://api.groq.com/openai/v1  GROK_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
GROK_API_KEY=                          # empty = no fallback (Gemini -> static mode)
GROK_BASE_URL=https://api.groq.com/openai/v1
GROK_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
GROK_TIMEOUT_MS=10000
GROK_REASONING_EFFORT=low              # gpt-oss on Groq only (low|medium|high); leave EMPTY for xAI Grok
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=1                      # retries on 5xx/network, and on 429 with a short Retry-After; timeouts move on at once
LLM_RATE_LIMIT_MAX_WAIT_MS=12000       # wait at most this long for a 429 Retry-After before moving to the next model
LLM_CONCURRENCY=8
LLM_FORCE_PRIMARY_FAIL=0               # 1 = simulate a Google outage (demo of the Grok fallback)
LLM_DISABLED=0                         # 1 = no LLM at all -> static mode
CIRCUIT_FAILS_TO_OPEN=5
CIRCUIT_OPEN_MS=30000

# --- Retrieval ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # local ONNX via fastembed, downloaded once (~90 MB)
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20                # per leg (BM25 and vector), before RRF fusion
RETRIEVAL_MIN_VECTOR_SIM=0.30          # relevance gate; tuned on the eval set

# --- Tools (simulated upstream services) ---
TOOL_TIMEOUT_MS=2000
TOOL_MAX_RETRIES=2                     # get_account_state only (raise_service_request is never blindly retried)
TOOL_FAIL_RATE=0.0833                  # 1/12 random upstream timeouts; 0 = deterministic, 1 = always fail
TOOL_FAIL_SEED=

# --- Agent ---
AS_OF_DATE=2026-11-12                  # "today" for date maths, pinned so answers are reproducible
PROMPT_VERSION=v5
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_MS=25000
CACHE_TTL_ACCOUNT_MS=0                 # 0 = never cache account state
ANSWER_CACHE_TTL_MS=900000             # 0 = disable the account-independent answer cache
